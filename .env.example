# Copy this file to `.env.local` (or set the variables in your hosting
# provider's environment, e.g. Vercel) and fill in real values.
# Never commit real secrets.

# --- Sentry (error monitoring / tracing / session replay) ---
# Public DSN. Never a secret — it is bundled into the client.
# https://docs.sentry.io/product/sentry-basics/concepts/dsn-explainer/
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>

# Sentry auth token — used only at build time to create releases and upload
# source maps. Generate one at Sentry → Settings → Auth Tokens (scope:
# project:write). Keep it out of the client bundle and out of version control.
# https://docs.sentry.io/product/accounts/auth-tokens/
SENTRY_AUTH_TOKEN=sntrys_<token>

# Sentry organization and project slugs (shown in the Sentry URL bar).
# Required for source map upload / release creation.
SENTRY_ORG=<org-slug>
SENTRY_PROJECT=<project-slug>

# --- Google Tag Manager (optional) ---
# When unset, the app renders no GTM script at all.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX